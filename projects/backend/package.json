{
  "name": "securities-trading-simulator-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --noEmit",
    "start": "tsx src/server.ts",
    "demo:week-one": "tsx scripts/run-week-one-demo.ts",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "migration:run": "tsx ./node_modules/typeorm/cli.js migration:run -d src/infrastructure/typeorm-data-source.ts",
    "migration:revert": "tsx ./node_modules/typeorm/cli.js migration:revert -d src/infrastructure/typeorm-data-source.ts",
    "migration:show": "tsx ./node_modules/typeorm/cli.js migration:show -d src/infrastructure/typeorm-data-source.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "mysql2": "^3.14.1",
    "redis": "^5.12.1",
    "typeorm": "^0.3.31",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.3",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.18.2",
    "jest": "^29.7.0",
    "supertest": "^7.1.0",
    "ts-jest": "^29.2.6",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
