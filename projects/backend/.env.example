PORT=3000
# Chỉ dùng tại local/demo; chỉ bật với NODE_ENV=development, test hoặc demo.
OMS_DEMO_ENABLED=false
CORS_ORIGIN=http://localhost:5173
# Khi NODE_ENV=development, localhost và 127.0.0.1 ở mọi cổng được cho phép.
# Với production, chỉ các origin liệt kê trong CORS_ORIGIN (phân tách bằng dấu phẩy) được cho phép.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=securities_simulator
DB_USER=simulator
DB_PASSWORD=simulator_local_password
DB_CONNECT_TIMEOUT_MS=3000
REDIS_URL=redis://localhost:6379
# Demo tuần 1 dùng FIXED; SYSTEM dùng đồng hồ thật.
SIM_CLOCK_MODE=FIXED
SIM_NOW=2026-10-20T10:00:00+07:00
MARKET_DATA_TRADING_DATE=2026-10-20
