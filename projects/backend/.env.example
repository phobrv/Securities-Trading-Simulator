PORT=3000
CORS_ORIGIN=http://localhost:5173
# Khi NODE_ENV=development, localhost và 127.0.0.1 ở mọi cổng được cho phép.
# Với production, chỉ các origin liệt kê trong CORS_ORIGIN (phân tách bằng dấu phẩy) được cho phép.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=securities_simulator
DB_USER=simulator
DB_PASSWORD=simulator_local_password
DB_CONNECT_TIMEOUT_MS=3000
REDIS_URL=redis://localhost:6379
# SYSTEM dùng đồng hồ thật. FIXED yêu cầu SIM_NOW là ISO 8601 có timezone.
SIM_CLOCK_MODE=SYSTEM
# SIM_NOW=2026-10-20T10:00:00+07:00
# Mặc định là ngày UTC tại thời điểm backend khởi động.
# MARKET_DATA_TRADING_DATE=2026-10-24
MARKET_DATA_TICK_INTERVAL_MS=2000
